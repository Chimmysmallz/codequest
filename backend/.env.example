# Copy to `.env` and adjust. Every value has a sensible default in config.py,
# so a fresh clone runs with NO .env at all (subprocess runner + firebase auth).
# For a Firebase-free local poke, set AUTH_MODE=insecure_dev (see below).

# --- Firebase auth ----------------------------------------------------------
# Optional: pin the Firebase project id (usually inferred from the key file).
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to a Firebase service-account JSON. Used by the Admin SDK to verify
# incoming ID tokens. If unset, Application Default Credentials are used.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# "firebase"     = verify Firebase ID tokens (production).
# "insecure_dev" = DEV ONLY: skip verification, use a fake identity. Never prod.
AUTH_MODE=firebase

# --- Code sandbox -----------------------------------------------------------
# "subprocess" = built-in dev runner (no Docker). "docker" = hardened sandbox.
SANDBOX_MODE=subprocess
# Image name used when SANDBOX_MODE=docker (build: docker build -t codequest-sandbox ./sandbox)
SANDBOX_IMAGE=codequest-sandbox
# Wall-clock seconds a single submission may run before it's killed.
RUN_TIMEOUT_S=3.0

# --- Rate limiting ----------------------------------------------------------
# Per-Firebase-user sliding-window limits on the two code endpoints. Over the
# limit, the endpoint returns HTTP 429 with a Retry-After header (seconds).
# CAVEAT: limiting is per-process/in-memory — each worker/instance counts on
# its own; for multi-instance deployments back it with Redis (see ratelimit.py).
# /run: max requests per window (seconds).
RUN_RATE_MAX=30
RUN_RATE_WINDOW_S=60
# /submit: max requests per window (seconds).
SUBMIT_RATE_MAX=60
SUBMIT_RATE_WINDOW_S=60
